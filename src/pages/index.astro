---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Echo Garden"
  description="A browser instrument you play, not read — touch the dark or press any letter and it sings back."
>
  <header class="sr-only">
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <p class="sr-only">
      Echo Garden — an interactive browser instrument. Touch, click, drag or
      press any letter key to play a live-synthesised note.
    </p>
    <div class="opening" data-opening>
      <h1>Touch the dark</h1>
      <p class="opening-secondary">or press any letter</p>
    </div>
    <canvas id="instrument-surface" aria-hidden="true"></canvas>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
